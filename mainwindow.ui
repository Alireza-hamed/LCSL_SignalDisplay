  <property name="styleSheet">
   <string notr="true">/* Set main window background to modern dark gray */
QMainWindow {
    background-color: #1e1e1e;
}

/* Styles for labels and checkable controls */
QLabel, QCheckBox {
    color: #e0e0e0;
    font-family: &quot;Segoe UI&quot;, Tahoma;
    font-size: 10pt;
}

/* Styles for channel configuration containers (GroupBox) */
QGroupBox {
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    margin-top: 12px;
    background-color: #252526;
    color: #007ACC;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* Styles for control action buttons (Start, Stop, Save) */
QPushButton {
    background-color: #333337;
    border: 1px solid #555555;
    border-radius: 4px;
    color: #ffffff;
    padding: 6px 12px;
    font-family: &quot;Segoe UI&quot;;
}
QPushButton:hover {
    background-color: #3f3f46;
    border: 1px solid #007ACC; /* Blue border on mouse hover */
}
QPushButton:pressed {
    background-color: #007ACC;
}

/* Styles for selection inputs (QComboBox / QSpinBox) */
QComboBox, QSpinBox {
    background-color: #333337;
    border: 1px solid #555555;
    color: white;
    border-radius: 3px;
    padding: 2px 5px;
}</string>
